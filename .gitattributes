* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.pdf binary
*.pt binary
*.pth binary
*.ckpt binary
*.npy binary
*.npz binary
*.parquet binary
*.safetensors binary
# Preserve audit hashes byte-for-byte, including original CSV line endings.
outputs/calibration_repair/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
outputs/regular_pinn_recovery/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
